# Neon connection string (Neon dashboard > Connect > copy the "pooled" URL)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Password for /admin
ADMIN_PASSWORD="change-me"

# Optional: secret used to hash voter IPs. Defaults to ADMIN_PASSWORD.
# Do not change it while a poll is running, or IP limits reset.
IP_SALT=""
